<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('includes/head', { title: 'All Posts' }) %>
  <link rel="stylesheet" href="/styles/posts.css">
</head>

<body>
  <%- include('includes/header') %>
  <main id="all-posts">
    <h1>All Posts</h1>
   <% if(!posts || posts.length === 0) { %>
   <p>No posts found. please create  <a class="btn" href="/new-post">a new post</a>  </p>
   <% } else { %>
    <ol id="posts-list">
      <% for (post of posts) { %>
        <%- include('includes/post-item', {post: post}) %>
        <% } }%>
    </ol>
  </main> 
</body>

</html>